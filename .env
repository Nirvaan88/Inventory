# ============================================================
#  KISNA INVENTORY — DATABASE SWITCHER
#  Change DB_MODE to switch between local and server database
# ============================================================

# ─── TOGGLE THIS LINE TO SWITCH ───────────────────────────
# Options: "local"  → your Office PC (Windows Auth, no password)
#          "sql"    → AWS Server SQL Server (username + password)
DB_MODE=local

# ─── LOCAL (Windows Auth) ─────────────────────────────────
# No password needed — uses your Windows login automatically
# Change DB_SERVER if your SQL Server instance name is different
DB_SERVER=KSNLPT642
DB_NAME=Inventorybkp

# ─── SERVER (SQL Auth) ────────────────────────────────────
# Used when DB_MODE=sql
DB_HOST=localhost
DB_USER=sa
DB_PASS=Admin@123
DB_PORT=1433

# ─── TAQTICS API (Franchise Store Sync) ──────────────────
TAQTICS_API_URL=https://kisna.taqtics.co/v1/external/store
TAQTICS_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..J2IP_lPX4Y8VXwyHM63-85gkqR73v69W1x1YHT667FQ

# ─── SESSION ──────────────────────────────────────────────
SESSION_SECRET=kisna-inventory-super-secret-2024

# ─── NODE ENV ─────────────────────────────────────────────
NODE_ENV=development

